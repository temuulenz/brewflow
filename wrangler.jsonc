{
  "name": "brewflow-app",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{"binding":"DB","database_name":"brewflow-db","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"MENU_IMAGES","bucket_name":"brewflow-menu"}],
  "kv_namespaces": [{"binding":"CAFE_SETTINGS","id":"00000000000000000000000000000000","preview_id":"00000000000000000000000000000000"}],
  "durable_objects": {"bindings":[{"name":"CAFE_ROOM","class_name":"CafeRoom"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["CafeRoom"]}]
}
